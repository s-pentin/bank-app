# Шаблон переменных окружения. Скопируйте в .env и подставьте реальные значения
# Секреты клиентов должны совпадать с keycloak/realm-export.json

DB_USERNAME=__DB_USERNAME__
DB_PASSWORD=__DB_PASSWORD__

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=__KEYCLOAK_ADMIN_PASSWORD__

ACCOUNTS_CLIENT_SECRET=__ACCOUNTS_CLIENT_SECRET__
CASH_CLIENT_SECRET=__CASH_CLIENT_SECRET__
TRANSFER_CLIENT_SECRET=__TRANSFER_CLIENT_SECRET__
